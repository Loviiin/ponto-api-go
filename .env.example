# Porta onde a sua API vai rodar
API_PORT=8083

# --- Configurações do Banco de Dados PostgreSQL ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# SSL mode: disable | require | verify-full (produção normalmente require/verify-full)
DB_SSLMODE=require

# --- JWT ---
JWT_SECRET_KEY=

# --- Scheduler ---
ENABLE_SCHEDULER=false
# SCHEDULER_SECRET=  # defina se usar scheduler protegido

# --- APIs externas ---
BRASILAPI_URL=https://brasilapi.com.br/api
DISTANCEMATRIX_API_KEY=
# API_OPENCAGE=   # obsoleto, será removido

# --- Cache (escolha um provedor) ---
# Upstash REST
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Redis nativo
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
REDIS_DB=0

# --- Cloudinary (Upload de Avatares) ---
# Obtenha suas credenciais em: https://cloudinary.com/console
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://238292259811144:zxABxjAF_kxM-uSGDac2N_eWr9M@dri2zbuch

# --- SMTP Configuration (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-app-password
SMTP_FROM_NAME=Nexora Ponto
SMTP_FROM_EMAIL=noreply@nexora.com

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# --- Frontend URL (para links em emails) ---
